---
import { LINKS, SITE, CONTACT } from "../i18n/site";

interface Props {
  dict: any;
  lang: string;
}
const { dict, lang } = Astro.props;
const homeHref = lang === "zh" ? "/" : `/${lang}`;
const email = CONTACT.email;

const contactItems = [
  {
    key: "telegram",
    label: "Telegram",
    value: CONTACT.telegram,
    href: CONTACT.telegram ? `https://t.me/${CONTACT.telegram.replace(/^@/, "")}` : ""
  },
  { key: "email", label: lang === "zh" ? "邮箱" : "Email", value: email, href: `mailto:${email}` },
  { key: "qq", label: "QQ", value: CONTACT.qq, href: CONTACT.qq ? `https://wpa.qq.com/msgrd?v=3&uin=${CONTACT.qq}&site=qq&menu=yes` : "" }
];

const navLinks = [
  { label: dict.nav.home, href: homeHref },
  { label: dict.nav.console, href: LINKS.console },
  { label: dict.nav.models, href: LINKS.models },
  { label: dict.nav.about, href: LINKS.about },
  { label: dict.nav.docs, href: LINKS.docs },
  { label: dict.nav.community, href: LINKS.community }
];
const contactLabel = lang === "zh" ? "邮箱" : "Email";
const comingSoon = lang === "zh" ? "敬请期待" : "Coming soon";
---
<footer class="border-t hairline footer-divider">
  <div class="mx-auto max-w-content px-6 py-14">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-sm">
        <div class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand text-white text-sm font-bold">T</span>
          <span class="font-display text-lg text-ink">TENET 信条</span>
        </div>
        <p class="mt-4 text-sm text-ink-secondary">{dict.footer.slogan}</p>
        <p class="mt-1 text-sm text-ink-muted">{dict.footer.tagline}</p>
      </div>
      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3">
        <div>
          <h3 class="section-tag text-ink-muted text-xs">{dict.footer.nav}</h3>
          <ul class="mt-4 space-y-2.5">
            {navLinks.map((link) => (
              <li><a href={link.href} class="text-sm text-ink-secondary hover:text-ink transition-colors">{link.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="section-tag text-ink-muted text-xs">{dict.footer.protocol}</h3>
          <ul class="mt-4 space-y-2.5">
            <li><a href="/docs" class="text-sm text-ink-secondary hover:text-ink transition-colors">{dict.footer.userAgreement}</a></li>
            <li><a href="/docs" class="text-sm text-ink-secondary hover:text-ink transition-colors">{dict.footer.privacy}</a></li>
          </ul>
        </div>
        <div>
          <h3 class="section-tag text-ink-muted text-xs">{dict.nav.contact}</h3>
          <ul class="mt-4 space-y-2.5">
            {contactItems.map((item) => (
              <li>
                <button
                  class="contact-trigger flex w-full items-center justify-between gap-3 rounded-xl2 border hairline bg-white px-4 py-2.5 text-sm font-medium text-ink-secondary hover:text-ink transition-all duration-500 ease-expo"
                  aria-expanded="false"
                  data-contact-trigger
                >
                  <span>{item.label}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="contact-chevron h-3.5 w-3.5 text-ink-muted"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/></svg>
                </button>
                <div class="contact-panel" data-contact-panel>
                  {item.value ? (
                    <a href={item.href} class="mt-1.5 block break-all rounded-xl2 bg-paper-soft px-4 py-2.5 text-sm text-ink transition-colors hover:bg-brand-faint hover:text-brand">
                      {item.key === "email" ? contactLabel : ""}{item.value}
                    </a>
                  ) : (
                    <span class="mt-1.5 block break-all rounded-xl2 bg-paper-soft px-4 py-2.5 text-sm text-ink-muted">{comingSoon}</span>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
    <div class="mt-12 flex flex-col items-center justify-between gap-3 border-t hairline pt-6 sm:flex-row">
      <p class="text-xs text-ink-muted">{dict.footer.rights}</p>
      <!-- 语言图标 + 下拉 -->
      <div class="relative">
        <button
          class="inline-flex items-center gap-2 rounded-pill border border-black/8 px-3 py-2 text-xs font-medium text-ink-secondary hover:text-ink transition-colors"
          aria-label={dict.lang.switch}
          aria-haspopup="true"
          aria-expanded="false"
          data-footer-lang-toggle
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"/></svg>
          {lang === "zh" ? "中文" : "EN"}
        </button>
        <div class="lang-menu absolute right-0 bottom-11 w-36 rounded-xl2 glass border border-white/60 shadow-liftLg p-1.5" data-footer-lang-menu>
          <a href="/" class="flex items-center justify-between rounded-lg2 px-3 py-2 text-sm text-ink hover:bg-black/4 transition-colors">
            中文 {lang === "zh" ? <span class="h-1.5 w-1.5 rounded-full bg-brand"></span> : null}
          </a>
          <a href="/en" class="flex items-center justify-between rounded-lg2 px-3 py-2 text-sm text-ink hover:bg-black/4 transition-colors">
            English {lang === "en" ? <span class="h-1.5 w-1.5 rounded-full bg-brand"></span> : null}
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  // 联系方式下拉：点击展开对应联系方式
  const triggers = document.querySelectorAll("[data-contact-trigger]");
  const panels = document.querySelectorAll("[data-contact-panel]");
  if (triggers.length) {
    triggers.forEach((trigger, idx) => {
      trigger.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = trigger.classList.toggle("open");
        trigger.setAttribute("aria-expanded", String(isOpen));
        if (panels[idx]) panels[idx].classList.toggle("open", isOpen);
        // 同时收起其他项
        triggers.forEach((other, j) => {
          if (j !== idx) {
            other.classList.remove("open");
            other.setAttribute("aria-expanded", "false");
            if (panels[j]) panels[j].classList.remove("open");
          }
        });
      });
    });
  }

  const ft = document.querySelector("[data-footer-lang-toggle]");
  const fm = document.querySelector("[data-footer-lang-menu]");
  if (ft && fm) {
    ft.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = fm.classList.toggle("open");
      ft.setAttribute("aria-expanded", String(open));
    });
    document.addEventListener("click", (e) => {
      if (!fm.contains(e.target) && !ft.contains(e.target)) {
        fm.classList.remove("open");
        ft.setAttribute("aria-expanded", "false");
      }
    });
  }
</script>

