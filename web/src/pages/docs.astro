---
import BaseLayout from "../layouts/BaseLayout.astro";
const lang = "zh";
const title = "文档 | TENET 信条";
const desc = "TENET 官方文档。";
---
<BaseLayout title={title} description={desc} lang={lang} pathname="/docs">
  <main class="pt-40 pb-28">
    <div class="mx-auto max-w-content px-6">
      <p class="mono-label text-brand">文档</p>
      <h1 class="font-display mt-4 text-4xl font-medium tracking-tight text-ink">快速上手的每一份资料</h1>
      <p class="mt-4 text-lg text-ink-secondary">文档体系将在后续版本建设。</p>
    </div>
  </main>
</BaseLayout>
