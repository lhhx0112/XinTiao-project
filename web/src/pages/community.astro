---
import BaseLayout from "../layouts/BaseLayout.astro";
const lang = "zh";
const title = "社区 | TENET 信条";
const desc = "TENET 社区。";
---
<BaseLayout title={title} description={desc} lang={lang} pathname="/community">
  <main class="pt-40 pb-28">
    <div class="mx-auto max-w-content px-6">
      <p class="mono-label text-brand">社区</p>
      <h1 class="font-display mt-4 text-4xl font-medium tracking-tight text-ink">和同样在做事的人在一起</h1>
      <p class="mt-4 text-lg text-ink-secondary">社区入口将在后续版本完善。</p>
    </div>
  </main>
</BaseLayout>
