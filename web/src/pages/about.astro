---
import BaseLayout from "../layouts/BaseLayout.astro";
const lang = "zh";
const title = "关于 TENET | TENET 信条";
const desc = "TENET「信条」— 服务用户，保护隐私，平台稳定。";
---
<BaseLayout title={title} description={desc} lang={lang} pathname="/about">
  <main class="pt-40 pb-28">
    <div class="mx-auto max-w-content px-6">
      <p class="mono-label text-brand">关于 TENET</p>
      <h1 class="font-display mt-4 text-4xl font-medium tracking-tight text-ink">我们相信，服务是信任的开始</h1>
      <p class="mt-4 text-lg text-ink-secondary">关于页面内容将在后续版本补充。</p>
    </div>
  </main>
</BaseLayout>
